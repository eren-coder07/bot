# Copy to .env and change every value. These must be SECRET.
# Shared secret used to encrypt configs to the app. MUST match APP_SECRET baked into the APK
# (set in the GitHub Actions build as the APP_SECRET secret). Generate: openssl rand -hex 32
APP_SECRET=change-me-shared-app-secret
# Admin panel password.
ADMIN_PASSWORD=change-me-admin-password
# Signs admin login cookies. Generate: openssl rand -hex 32
COOKIE_SECRET=change-me-cookie-secret
# Where the SQLite database file lives.
DB_PATH=/var/lib/payloadtunnel/data.db
